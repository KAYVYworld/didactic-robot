    <button class="surprise-button" onclick="showSurprise()">
        Open Your Surprise ❤️
    </button>

    <div id="surpriseMessage">
        Portia, never forget how special you are.
        May your smile stay bright, your dreams grow bigger,
        and your heart always find reasons to be happy.

        <br><br>

        Happy Birthday once again! ❤️

        <br><br>

        — Kojo
    </div>
</section>

<footer>
    Made with love, just for Portia ❤️
    <br>
    From Kojo
</footer>

<script>
/* ORIGINAL SOFT PIANO-STYLE MELODY
   Synthesized in the browser; no external song is used. */

let audioContext = null;
let masterGain = null;
let musicPlaying = false;
let melodyTimer = null;
let noteIndex = 0;

const melody = [
    [523.25, 659.25, 783.99],
    [493.88, 587.33, 739.99],
    [440.00, 523.25, 659.25],
    [392.00, 493.88, 587.33],
    [440.00, 523.25, 659.25],
    [493.88, 587.33, 739.99],
    [523.25, 659.25, 783.99],
    [392.00, 493.88, 587.33]
];

function playPianoNote(frequency, startTime, duration) {
    const fundamental = audioContext.createOscillator();
    const overtone = audioContext.createOscillator();
    const noteGain = audioContext.createGain();

    fundamental.type = "triangle";
    overtone.type = "sine";

    fundamental.frequency.value = frequency;
    overtone.frequency.value = frequency * 2;

    const volume = 0.10;

    noteGain.gain.setValueAtTime(0.0001, startTime);
    noteGain.gain.exponentialRampToValueAtTime(
        volume, startTime + 0.015
    );
    noteGain.gain.exponentialRampToValueAtTime(
        0.0001, startTime + duration
    );

    fundamental.connect(noteGain);
    overtone.connect(noteGain);

    noteGain.connect(masterGain);

    fundamental.start(startTime);
    overtone.start(startTime);

    fundamental.stop(startTime + duration + 0.05);
    overtone.stop(startTime + duration + 0.05);
}

function playMelody() {
    if (!musicPlaying) return;

    const now = audioContext.currentTime;
    const chord = melody[noteIndex];

    chord.forEach((frequency, index) => {
        playPianoNote(
            frequency,
            now + index * 0.035,
            1.7
        );
    });

    // A gentle higher note gives the melody a delicate feel.
    playPianoNote(chord[0] * 2, now + 0.15, 1.1);

    noteIndex = (noteIndex + 1) % melody.length;
    melodyTimer = setTimeout(playMelody, 1500);
}

async function toggleMusic() {
    const button = document.getElementById("musicButton");

    if (!audioContext) {
        const AudioContextClass =
            window.AudioContext || window.webkitAudioContext;

        if (!AudioContextClass) {
            button.textContent = "Audio not supported";
            return;
        }

        audioContext = new AudioContextClass();
        masterGain = audioContext.createGain();
        masterGain.gain.value = 0;
        masterGain.connect(audioContext.destination);
    }

    if (!musicPlaying) {
        await audioContext.resume();

        musicPlaying = true;

        masterGain.gain.cancelScheduledValues(audioContext.currentTime);
        masterGain.gain.setTargetAtTime(
            0.35, audioContext.currentTime, 0.8
        );

        button.textContent = "Ⅱ Pause Piano";
        playMelody();

    } else {
        musicPlaying = false;
        clearTimeout(melodyTimer);

        masterGain.gain.cancelScheduledValues(audioContext.currentTime);
        masterGain.gain.setTargetAtTime(
            0, audioContext.currentTime, 0.3
        );

        button.textContent = "♫ Play Sweet Piano";
    }
}

document.getElementById("musicButton")
    .addEventListener("click", toggleMusic);

function showSurprise() {
    const message = document.getElementById("surpriseMessage");

    message.style.display = "block";

    for (let i = 0; i < 18; i++) {
        setTimeout(createHeart, i * 120);
    }
}

function createHeart() {
    const heart = document.createElement("div");

    heart.className = "floating-heart";
    heart.textContent = "♥";
    heart.style.left = Math.random() * 100 + "vw";
    heart.style.fontSize = (15 + Math.random() * 25) + "px";

    document.body.appendChild(heart);

    setTimeout(() => heart.remove(), 6000);
}

// A few gentle floating hearts appear occasionally.
setInterval(() => {
    if (Math.random() > 0.45) createHeart();
}, 1800);
</script>

</body>
</html>
