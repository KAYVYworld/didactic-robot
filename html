    object-fit: cover;
    border-radius: 18px;
    box-shadow: 0 8px 25px rgba(130, 65, 85, .15);
    transition: transform .3s;
}

.gallery img:hover {
    transform: translateY(-7px);
}

.card {
    max-width: 750px;
    margin: 25px auto;
    padding: 35px 25px;
    background: rgba(255,255,255,.7);
    border-radius: 22px;
    box-shadow: 0 8px 25px rgba(130, 65, 85, .09);
    line-height: 2;
    font-size: 18px;
