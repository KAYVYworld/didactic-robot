}

.surprise-button {
    background: #a83f63;
    color: white;
    padding: 15px 28px;
    border: none;
    border-radius: 30px;
    font-size: 16px;
    cursor: pointer;
    margin-top: 20px;
}

#surpriseMessage {
    display: none;
    margin: 25px auto 0;
    max-width: 650px;
    font-size: 20px;
    line-height: 1.8;
    color: #a83f63;
}

footer {
    padding: 35px 15px;
    background: #f5d8e1;
    line-height: 2;
}

.floating-heart {
    position: fixed;
    bottom: -30px;
    color: #d45b80;
    pointer-events: none;
    animation: floatUp 6s linear forwards;
    z-index: 10;
}

@keyframes floatUp {
    to {
        transform: translateY(-110vh) rotate(360deg);
        opacity: 0;
    }
